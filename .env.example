APP_NAME=investment-agent-system
APP_ENV=development
LOG_LEVEL=INFO

# Required for LLM reasoning (Ollama Cloud)
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=glm-5.1:cloud
# Used automatically when primary model is capacity-gated / unavailable.
OLLAMA_FALLBACK_MODELS=gpt-oss:20b-cloud,qwen3.5:cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_TEMPERATURE=0.2
# How many automatic JSON schema-repair retries to run when a model returns malformed output.
OLLAMA_SCHEMA_REPAIR_ATTEMPTS=1
# Throttle concurrent LLM requests to avoid cloud 429s during multi-agent runs.
OLLAMA_MAX_CONCURRENCY=2
# Timeout (seconds) for each single Ollama chat request.
OLLAMA_REQUEST_TIMEOUT_SECONDS=90

# Optional (if unset the system uses free fallback sources)
NEWSAPI_KEY=
FMP_API_KEY=

# Data + runtime
DATABASE_URL=sqlite:///./data/investment_agent.db
REPORTS_DIR=./reports
REQUEST_TIMEOUT_SECONDS=30
MAX_NEWS_ARTICLES=30
MAX_WEB_RESULTS=30
REQUIRED_CONDA_ENV=myenv
ENFORCE_CONDA_ENV=true

# SEC requires a descriptive user-agent with contact details
SEC_USER_AGENT=InvestmentAgentSystem/0.1 (aditya25678@gmail.com)
